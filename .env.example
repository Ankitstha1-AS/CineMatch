# Copy this file to .env and fill in real values. Never commit .env.

# --- Backend ---
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (local development) ---
POSTGRES_USER=cinematch
POSTGRES_PASSWORD=cinematch
POSTGRES_DB=cinematch
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cinematch:cinematch@localhost:5432/cinematch

# --- API ---
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# --- Frontend ---
FRONTEND_PORT=8080
# Leave empty to use the Vite dev proxy / same-origin Nginx proxy.
VITE_API_BASE_URL=

# --- TMDB (display metadata only; never used for training) ---
TMDB_API_KEY=
